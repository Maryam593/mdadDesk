# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verify the current Flash model id in AI Studio before the demo
GEMINI_MODEL=gemini-2.5-flash
# Web origin allowed by CORS (comma-separated)
ALLOWED_ORIGIN=http://localhost:5173
PORT=8080
# Set to "true" once Firebase Auth is configured to require ID tokens
REQUIRE_AUTH=false
