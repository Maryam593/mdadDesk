# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated: first is main, the rest are backups. Check ids with: npm run check-ai -w api
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Web origin allowed by CORS (comma-separated)
ALLOWED_ORIGIN=http://localhost:5173
PORT=8080
# Set to "true" once Firebase Auth is configured to require ID tokens
REQUIRE_AUTH=false
# Password for all demo accounts, used by npm run seed. Never commit the real one.
DEMO_PASSWORD=
